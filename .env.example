# Copy to .env.local and fill in (see README → "Setting up .env.local"). Never commit .env.local.
# Wrap values containing $, # or spaces in single quotes: KEY='value'

# Supabase (Project Settings → API). The publishable key is safe in the browser: RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Used by the Supabase CLI (link / db push / seed).
# Access token: https://supabase.com/dashboard/account/tokens (needed because the CLI login
# flow requires an interactive terminal). DB password: Project Settings → Database.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Public URL of the site, used for metadata, sitemap and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protects the keep-alive cron endpoint (Vercel sends it as a Bearer token).
CRON_SECRET=
