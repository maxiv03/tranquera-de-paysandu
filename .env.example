# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings → API). The publishable key is safe in the browser: RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Used by the Supabase CLI (db push / seed) — the database password of the project.
SUPABASE_DB_PASSWORD=

# Public URL of the site, used for metadata, sitemap and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protects the keep-alive cron endpoint (Vercel sends it as a Bearer token).
CRON_SECRET=
