{
  "name": "web-rural",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:i18n",
    "db:link": "node scripts/supabase.mjs link --project-ref {ref}",
    "db:push": "node scripts/supabase.mjs db push --linked",
    "db:seed": "node scripts/supabase.mjs db query --linked -f supabase/seed.sql",
    "db:types": "node scripts/supabase.mjs gen types typescript --linked --schema public > src/lib/supabase/database.types.ts",
    "db:reset-demo": "npm run db:push && npm run db:seed"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
